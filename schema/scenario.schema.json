{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan825/Stampede/schema/scenario.schema.json",
  "title": "Stampede scenario",
  "description": "A load test: what to hit, how users behave, how much load and what counts as passing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "journeys", "load"],
  "properties": {
    "apiVersion": { "const": "stampede.dev/v1", "default": "stampede.dev/v1" },
    "kind": { "const": "Scenario", "default": "Scenario" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9._-]{0,98}[a-z0-9])?$", "description": "Lowercase letters, digits, '.', '_' or '-'." },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseURL": { "type": "string", "description": "Prefixed to relative paths. May be templated, e.g. ${env.TARGET_URL}." },
        "verify": { "enum": ["dns-txt", "well-known"], "description": "Ownership check for public targets." },
        "headers": { "$ref": "#/$defs/stringMap" },
        "timeout": { "$ref": "#/$defs/duration", "description": "Default per-request timeout (30s)." },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "connections": { "enum": ["per-vu", "shared"], "default": "per-vu", "description": "per-vu: each user has its own keep-alive connections like a browser; shared: one pool like a service client." },
            "http2": { "type": "boolean", "description": "Negotiate HTTP/2 over TLS when the server offers it." },
            "h2c": { "type": "boolean", "description": "Speak HTTP/2 without TLS to http:// targets (prior knowledge)." },
            "disableKeepAlive": { "type": "boolean" },
            "insecureSkipVerify": { "type": "boolean", "description": "Skip TLS certificate checks (test targets only)." },
            "maxRedirects": { "type": "integer", "description": "0 = default 10, -1 = do not follow." },
            "dnsCacheTTL": { "$ref": "#/$defs/duration", "description": "Reuse DNS answers across connections for this long (default 30s; 0s disables)." }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "description": "Emulate a slower network for every virtual user. Explicit values override the profile.",
          "properties": {
            "profile": { "enum": ["slow-3g", "3g", "4g", "slow-wifi"] },
            "rtt": { "$ref": "#/$defs/duration" },
            "down": { "type": "string", "description": "Download bandwidth, e.g. 1.6mbps" },
            "up": { "type": "string", "description": "Upload bandwidth, e.g. 768kbps" },
            "jitter": { "$ref": "#/$defs/duration", "description": "Vary each round trip by up to this much either way." },
            "loss": { "$ref": "#/$defs/percent", "description": "Share of transfers stalled by a retransmission timeout, e.g. 1%." }
          }
        }
      }
    },
    "vars": { "type": "object", "description": "Static variables, available by name in expressions." },
    "data": {
      "type": "object",
      "description": "Test data feeders, available as ${data.<name>}.",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/feeder" }
    },
    "journeys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/journey" } },
    "load": { "$ref": "#/$defs/load" },
    "targets": {
      "type": "array",
      "description": "Pass/fail targets such as 'http.p95 < 500ms', 'errors < 1%', 'checkout.p99 < 1s', 'shop/GET /cart.p95 < 300ms'.",
      "items": { "type": "string", "pattern": "^\\s*[^<>=\\s][^<>=]*(<=|>=|==|<|>)\\s*\\S+\\s*$" }
    },
    "observe": {
      "type": "object",
      "additionalProperties": false,
      "description": "Link the run to the target's own telemetry: Prometheus metrics charted in the report, and trace links for the slowest requests.",
      "properties": {
        "prometheus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["queries"],
          "description": "After the run, each query is evaluated over the run's time range (query_range) and charted in the report.",
          "properties": {
            "url": { "type": "string", "description": "Prometheus base URL, for stampede run. May be templated, e.g. ${env.PROM_URL}." },
            "bearerToken": { "type": "string", "description": "Sent as Authorization: Bearer, for stampede run. May be templated, e.g. ${secret.PROM_TOKEN}." },
            "integration": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$", "description": "Name of a Prometheus integration configured on the server, for server runs." },
            "queries": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 20,
              "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$" },
              "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "description": "Name to PromQL expression, e.g. cpu: 'rate(process_cpu_seconds_total{job=\"shop\"}[30s])'."
            }
          },
          "oneOf": [{ "required": ["url"] }, { "required": ["integration"] }]
        },
        "traces": {
          "type": "object",
          "additionalProperties": false,
          "description": "Turn the trace IDs of the slowest requests into links. Nothing is fetched.",
          "properties": {
            "url": { "type": "string", "pattern": "\\{traceId\\}", "description": "Link template, e.g. https://jaeger.example.com/trace/{traceId}." },
            "integration": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$", "description": "Name of a traces integration configured on the server." }
          },
          "oneOf": [{ "required": ["url"] }, { "required": ["integration"] }]
        }
      }
    },
    "faults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "timeline"],
      "description": "Break dependencies on purpose during the run through a stampede agent. Every fault is reverted when it ends, when the run ends or is killed.",
      "properties": {
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "token"],
          "properties": {
            "url": { "type": "string", "description": "The agent's control API, e.g. ${env.AGENT_URL}." },
            "token": { "type": "string", "description": "The agent's token, e.g. ${secret.AGENT_TOKEN}." }
          }
        },
        "timeline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "for"],
            "properties": {
              "name": { "type": "string" },
              "at": { "$ref": "#/$defs/duration", "description": "When the fault starts, after the load starts." },
              "for": { "$ref": "#/$defs/duration", "description": "How long it lasts." },
              "proxy": { "type": "string", "description": "One of the agent's proxies." },
              "latency": { "$ref": "#/$defs/duration", "description": "Added to each direction." },
              "jitter": { "$ref": "#/$defs/duration" },
              "bandwidth": { "type": "string", "description": "Per connection and direction, in bits per second, e.g. 1mbps or 768kbps." },
              "reset": { "type": "boolean", "description": "Reset open connections and new ones." },
              "refuse": { "type": "boolean", "description": "Reset new connections." },
              "blackhole": { "type": "boolean", "description": "Stop forwarding; requests time out." },
              "container": { "type": "string", "description": "A Docker container the agent may act on." },
              "action": { "enum": ["pause", "stop", "kill", "restart"] },
              "deployment": { "type": "string", "description": "A Kubernetes deployment, namespace/name." },
              "replicas": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "duration": { "type": ["string", "number"], "pattern": "^[0-9.]+(ns|us|µs|ms|s|m|h|d)?([0-9.]+(ns|us|µs|ms|s|m|h))*$", "description": "e.g. 500ms, 2s, 1m30s, 4h. A bare number is seconds." },
    "rate": { "type": ["string", "number"], "pattern": "^[0-9.]+(/(s|sec|second|m|min|minute|h|hour))?$", "description": "e.g. 50/s, 3000/m." },
    "percent": { "type": ["string", "number"], "description": "e.g. 1% or 0.01." },
    "stringMap": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "feeder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "csv": { "type": "string", "description": "CSV file with a header row; each row is a map." },
        "json": { "type": "string", "description": "JSON file containing an array." },
        "list": { "type": "array" },
        "range": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "mode": { "enum": ["sequential", "unique", "random", "per-vu"], "default": "sequential", "description": "unique rows are never reused and are partitioned across workers." },
        "onExhausted": { "enum": ["stop", "wrap"], "default": "stop" }
      },
      "oneOf": [
        { "required": ["csv"] }, { "required": ["json"] }, { "required": ["list"] }, { "required": ["range"] }
      ]
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "steps"],
      "properties": {
        "name": { "type": "string", "pattern": "^[^/]+$" },
        "weight": { "type": "integer", "minimum": 0, "default": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "p50": { "$ref": "#/$defs/duration" },
            "p90": { "$ref": "#/$defs/duration" },
            "p95": { "$ref": "#/$defs/duration" },
            "p99": { "$ref": "#/$defs/duration" },
            "errors": { "$ref": "#/$defs/percent" }
          }
        },
        "steps": { "$ref": "#/$defs/steps" }
      }
    },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "common": {
      "name": { "type": "string" },
      "if": { "type": "string", "description": "Skip the step unless this expression is true." }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "description": "200, [200, 201] or \"2xx\".", "anyOf": [{ "type": "integer" }, { "type": "string" }, { "type": "array", "items": { "type": ["integer", "string"] } }] },
        "bodyContains": { "type": "string" },
        "json": { "type": "object", "description": "JSONPath -> expected value, or \"exists\"." },
        "maxLatency": { "$ref": "#/$defs/duration" },
        "expr": { "type": "string", "description": "Boolean expression over status, headers, body, json, latencyMs." },
        "allowErrors": { "type": "boolean", "description": "GraphQL only: accept a response whose errors array is not empty." }
      }
    },
    "grpcCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "description": "Accepted gRPC status names, e.g. OK or [OK, NOT_FOUND] (default OK).",
          "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
        },
        "json": { "type": "object", "description": "JSONPath -> expected value, or \"exists\"." },
        "maxLatency": { "$ref": "#/$defs/duration" },
        "expr": { "type": "string" }
      }
    },
    "request": {
      "headers": { "$ref": "#/$defs/stringMap" },
      "query": { "$ref": "#/$defs/stringMap" },
      "json": { "description": "JSON body; strings may contain ${} expressions." },
      "body": { "type": "string" },
      "form": { "$ref": "#/$defs/stringMap" },
      "check": { "$ref": "#/$defs/check" },
      "extract": {
        "type": "object",
        "description": "variable -> \"$.json.path\", \"header:Name\", \"cookie:name\", \"regex:(...)\", \"css:selector[@attr]\", \"status\" or \"body\".",
        "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "additionalProperties": { "type": "string" }
      },
      "timeout": { "$ref": "#/$defs/duration" }
    },
    "step": {
      "type": "object",
      "description": "Exactly one action: an HTTP method, graphql, sse, ws (with send and expect inside), grpc, plugin, think, branch, loop, while or group.",
      "properties": {
        "name": { "type": "string" },
        "if": { "type": "string" },
        "get": { "type": "string" }, "post": { "type": "string" }, "put": { "type": "string" },
        "patch": { "type": "string" }, "delete": { "type": "string" }, "head": { "type": "string" }, "options": { "type": "string" },
        "headers": { "$ref": "#/$defs/stringMap" },
        "query": { "description": "HTTP: query parameters. graphql: the query document.", "anyOf": [{ "$ref": "#/$defs/stringMap" }, { "type": "string" }] },
        "json": {},
        "body": { "type": "string" },
        "form": { "$ref": "#/$defs/stringMap" },
        "check": { "$ref": "#/$defs/check" },
        "extract": { "type": "object", "additionalProperties": { "type": "string" } },
        "timeout": { "$ref": "#/$defs/duration" },
        "think": { "type": "string", "description": "Pause: \"2s\" or a random range \"2s..6s\"." },
        "branch": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["weight", "steps"],
            "properties": { "weight": { "type": "integer", "minimum": 1 }, "name": { "type": "string" }, "steps": { "$ref": "#/$defs/steps" } }
          }
        },
        "loop": { "type": "integer", "minimum": 1 },
        "while": { "type": "string" },
        "max": { "type": "integer", "minimum": 1 },
        "group": { "type": "string" },
        "steps": { "$ref": "#/$defs/steps" },
        "graphql": { "type": "string", "description": "GraphQL endpoint; the operation is POSTed as JSON." },
        "variables": { "type": "object", "description": "GraphQL variables; strings may contain ${} expressions." },
        "operationName": { "type": "string" },
        "persisted": {
          "description": "Automatic persisted query: true hashes the query; {sha256} sends a known hash.",
          "anyOf": [
            { "type": "boolean" },
            { "type": "object", "additionalProperties": false, "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } } }
          ]
        },
        "sse": { "type": "string", "description": "Server-sent event stream URL. Records time to first event and events per second." },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "get", "post", "put", "patch", "delete"], "description": "sse: HTTP method (default GET, or POST when a body is set)." },
        "until": {
          "type": "object",
          "additionalProperties": false,
          "description": "sse: when to stop. events and match must be met; duration caps the stream.",
          "properties": {
            "events": { "type": "integer", "minimum": 1 },
            "match": { "type": "string", "description": "Regex matched against each event's data." },
            "duration": { "$ref": "#/$defs/duration" }
          }
        },
        "ws": { "type": "string", "description": "WebSocket URL (ws://, wss://, http(s):// or a path). Opens a connection for the steps inside; the handshake is the step's latency." },
        "subprotocols": { "type": "array", "items": { "type": "string" } },
        "send": { "description": "Inside ws: a text message (template) or a JSON value whose strings may contain ${} expressions." },
        "expect": {
          "description": "Inside ws: wait for a matching message; latency runs from the last send. A string is a regex.",
          "anyOf": [
            { "type": "string" },
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "match": { "type": "string", "description": "Regex over the message." },
                "json": { "type": "object", "description": "JSONPath -> expected value, or \"exists\"." },
                "timeout": { "$ref": "#/$defs/duration" }
              }
            }
          ]
        },
        "grpc": { "type": "string", "pattern": "^/?[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*/[A-Za-z_][A-Za-z0-9_]*$", "description": "gRPC method: package.Service/Method (unary or server streaming)." },
        "target": { "type": "string", "description": "grpc: grpc://host:port or grpcs://host:port (default: the host of target.baseURL)." },
        "message": { "type": "object", "description": "grpc: the request as JSON (protojson names); strings may contain ${} expressions." },
        "metadata": { "$ref": "#/$defs/stringMap" },
        "protoset": { "type": "string", "description": "grpc: FileDescriptorSet file instead of server reflection." },
        "proto": { "description": "grpc: .proto source file(s) instead of server reflection.", "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "importPaths": { "type": "array", "items": { "type": "string" }, "description": "grpc: where proto files and their imports are found (default: the scenario's directory)." },
        "plugin": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}\\.[A-Za-z][A-Za-z0-9_-]{0,62}$", "description": "A step implemented by a plugin: <plugin>.<step>, such as mqtt.publish. Install plugins with `stampede plugin install`." },
        "with": { "type": "object", "description": "plugin: the step's settings; strings may contain ${} expressions. Checked against the schema the plugin describes when it is installed." }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "required": ["graphql"] }, "then": { "properties": { "query": { "type": "string" } } } },
        { "if": { "required": ["grpc"] }, "then": { "properties": { "check": { "$ref": "#/$defs/grpcCheck" } } } }
      ],
      "oneOf": [
        { "required": ["get"] }, { "required": ["post"] }, { "required": ["put"] }, { "required": ["patch"] },
        { "required": ["delete"] }, { "required": ["head"] }, { "required": ["options"] },
        { "required": ["graphql"] }, { "required": ["sse"] },
        { "required": ["ws", "steps"] }, { "required": ["send"] }, { "required": ["expect"] }, { "required": ["grpc"] },
        { "required": ["plugin"] },
        { "required": ["think"] }, { "required": ["branch"] }, { "required": ["loop", "steps"] },
        { "required": ["while", "steps"] }, { "required": ["group", "steps"] }
      ]
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": { "enum": ["smoke", "baseline", "stress", "spike", "soak", "breakpoint", "steps", "recovery", "wave"] },
        "mode": { "enum": ["vus", "rate"], "description": "rate: open model, journeys start on a schedule; vus: closed model, a fixed population loops." },
        "vus": { "type": "integer", "minimum": 1 },
        "rate": { "$ref": "#/$defs/rate" },
        "duration": { "$ref": "#/$defs/duration" },
        "start": { "type": ["string", "number"], "description": "Starting level for shapes: a rate in rate mode, a user count in vus mode." },
        "max": { "type": ["string", "number"], "description": "Highest level for shapes." },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["duration", "target"],
            "properties": { "duration": { "$ref": "#/$defs/duration" }, "target": { "type": ["string", "number"] } }
          }
        },
        "steps": { "type": "integer", "minimum": 1, "description": "Levels in the breakpoint and steps shapes." },
        "stepDuration": { "$ref": "#/$defs/duration" },
        "cycles": { "type": "integer", "minimum": 1, "description": "Cycles in the wave shape." },
        "iterations": { "type": "integer", "minimum": 1 },
        "maxVUs": { "type": "integer", "minimum": 1 },
        "gracefulStop": { "$ref": "#/$defs/duration" },
        "abort": {
          "type": "object",
          "additionalProperties": false,
          "description": "Stop the run early when errors or p95 stay above a limit for 'for' (default 10s).",
          "properties": {
            "errors": { "$ref": "#/$defs/percent" },
            "p95": { "$ref": "#/$defs/duration" },
            "for": { "$ref": "#/$defs/duration" }
          }
        }
      }
    }
  }
}
