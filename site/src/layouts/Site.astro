---
import '../styles/site.css';
import { GITHUB } from '../lib/data';
interface Props { title?: string; description?: string }
const { title, description = 'Self-hosted, open-source load testing. Describe your users; Stampede checks each journey, then runs thousands of them across distributed workers and shows where your product breaks.' } = Astro.props;
const full = title ? `${title} · Stampede` : 'Stampede · Your launch-day traffic, before launch day';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#18181b" />
    <script is:inline>
      // Apply the saved theme before first paint. "starlight-theme" is the
      // docs' key ('' or missing means auto), so one choice covers both.
      (() => {
        let t = '';
        try { t = localStorage.getItem('starlight-theme') || ''; } catch {}
        const light = t === 'light' || (t !== 'dark' && matchMedia('(prefers-color-scheme: light)').matches);
        document.documentElement.dataset.theme = light ? 'light' : 'dark';
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;600&display=swap" />
  </head>
  <body>
    <nav class="nav" aria-label="Main">
      <div class="wrap">
        <a class="brand" href="/"><img class="logo-dark" src="/logo-dark.svg" alt="Stampede" /><img class="logo-light" src="/logo-light.svg" alt="Stampede" /></a>
        <ul>
          <li class="hide-sm"><a href="/#demo">See it run</a></li>
          <li class="hide-sm"><a href="/how-it-works">How it works</a></li>
          <li class="hide-sm"><a href="/test-types">Test types</a></li>
          <li><a href="/docs/">Docs</a></li>
          <li>
            <button class="theme" type="button" data-mode="auto" aria-label="Theme: auto" title="Theme: auto">
              <svg data-icon="auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" /></svg>
              <svg data-icon="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
              <svg data-icon="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
              <span class="hide-sm-text">Auto</span>
            </button>
          </li>
          <li><a class="btn btn-primary" href={GITHUB}>Run it locally ↗</a></li>
        </ul>
      </div>
    </nav>
    <main><slot /></main>
    <footer class="foot">
      <div class="wrap">
        <img class="logo-dark" src="/logo-dark.svg" alt="Stampede" /><img class="logo-light" src="/logo-light.svg" alt="Stampede" />
        <span>© 2026 Stampede · Apache-2.0</span>
        <ul>
          <li><a href={GITHUB}>GitHub</a></li>
          <li><a href="/docs/">Docs</a></li>
          <li><a href="/what-you-can-test">What you can test</a></li>
          <li><a href="/safety">Safety</a></li>
          <li><a href="/benchmarks">Benchmarks</a></li>
          <li><a href={`${GITHUB}/blob/main/LICENSE`}>Licence</a></li>
        </ul>
      </div>
    </footer>
    <script>
      // Theme picker: auto → light → dark. Auto follows the system.
      {
        const key = 'starlight-theme';
        const btn = document.querySelector<HTMLButtonElement>('.theme');
        const load = () => {
          try {
            const t = localStorage.getItem(key);
            return t === 'light' || t === 'dark' ? t : 'auto';
          } catch {
            return 'auto';
          }
        };
        const apply = (mode: string) => {
          const light = mode === 'light' || (mode === 'auto' && matchMedia('(prefers-color-scheme: light)').matches);
          document.documentElement.dataset.theme = light ? 'light' : 'dark';
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', light ? '#fafafa' : '#18181b');
          if (btn) {
            const label = mode[0].toUpperCase() + mode.slice(1);
            btn.dataset.mode = mode;
            btn.setAttribute('aria-label', `Theme: ${mode}`);
            btn.title = `Theme: ${mode} (click to change)`;
            const text = btn.querySelector('span');
            if (text) text.textContent = label;
          }
        };
        apply(load());
        btn?.addEventListener('click', () => {
          const next = { auto: 'light', light: 'dark', dark: 'auto' }[load()] ?? 'auto';
          try {
            localStorage.setItem(key, next === 'auto' ? '' : next);
          } catch {}
          apply(next);
        });
        matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
          if (load() === 'auto') apply('auto');
        });
      }

      // Copy buttons for every command on the page: terminal panels copy
      // their "$" lines (or everything, if none), command tables their
      // first-column code.
      const copyText = async (text: string, btn: HTMLButtonElement) => {
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Copied';
        } catch {
          btn.textContent = 'Press ⌘C';
        }
        setTimeout(() => (btn.textContent = 'Copy'), 1600);
      };
      const button = (label = 'Copy') => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'copy';
        b.textContent = label;
        return b;
      };
      document.querySelectorAll<HTMLElement>('.term').forEach((term) => {
        const pre = term.querySelector('pre');
        const bar = term.querySelector('.bar');
        if (!pre || !bar) return;
        const lines = pre.innerText.split('\n');
        const cmds = lines.filter((l) => l.startsWith('$ ')).map((l) => l.slice(2));
        const text = (cmds.length ? cmds : lines.filter((l) => l.trim() && !l.trim().startsWith('#'))).join('\n');
        const b = button();
        b.setAttribute('aria-label', 'Copy the commands');
        b.addEventListener('click', () => copyText(text, b));
        bar.appendChild(b);
      });
      document.querySelectorAll<HTMLTableElement>('table').forEach((table) => {
        const head = table.querySelector('th');
        if (!head || !/command/i.test(head.textContent || '')) return;
        table.querySelectorAll<HTMLElement>('tbody tr td:first-child code').forEach((code) => {
          const b = button();
          b.classList.add('copy-inline');
          b.setAttribute('aria-label', `Copy ${code.textContent}`);
          b.addEventListener('click', () => copyText(code.textContent || '', b));
          code.after(b);
        });
      });
    </script>
  </body>
</html>
