---
import '../styles/site.css';
import { GITHUB } from '../lib/data';
interface Props { title?: string; description?: string }
const { title, description = 'Self-hosted, open-source load testing. Describe your users; Stampede checks each journey, then runs thousands of them across distributed workers and shows where your product breaks.' } = Astro.props;
const full = title ? `${title} · Stampede` : 'Stampede · Your launch-day traffic, before launch day';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#18181b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;600&display=swap" />
  </head>
  <body>
    <nav class="nav" aria-label="Main">
      <div class="wrap">
        <a class="brand" href="/"><img src="/logo-dark.svg" alt="Stampede" /></a>
        <ul>
          <li class="hide-sm"><a href="/#demo">See it run</a></li>
          <li class="hide-sm"><a href="/how-it-works">How it works</a></li>
          <li class="hide-sm"><a href="/test-types">Test types</a></li>
          <li><a href="/docs/">Docs</a></li>
          <li><a class="btn btn-primary" href={GITHUB}>Run it locally ↗</a></li>
        </ul>
      </div>
    </nav>
    <main><slot /></main>
    <footer class="foot">
      <div class="wrap">
        <img src="/logo-dark.svg" alt="Stampede" />
        <span>© 2026 Stampede · Apache-2.0</span>
        <ul>
          <li><a href={GITHUB}>GitHub</a></li>
          <li><a href="/docs/">Docs</a></li>
          <li><a href="/what-you-can-test">What you can test</a></li>
          <li><a href="/safety">Safety</a></li>
          <li><a href="/benchmarks">Benchmarks</a></li>
          <li><a href={`${GITHUB}/blob/main/LICENSE`}>Licence</a></li>
        </ul>
      </div>
    </footer>
    <script>
      // Copy buttons for every command on the page: terminal panels copy
      // their "$" lines (or everything, if none), command tables their
      // first-column code.
      const copyText = async (text: string, btn: HTMLButtonElement) => {
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Copied';
        } catch {
          btn.textContent = 'Press ⌘C';
        }
        setTimeout(() => (btn.textContent = 'Copy'), 1600);
      };
      const button = (label = 'Copy') => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'copy';
        b.textContent = label;
        return b;
      };
      document.querySelectorAll<HTMLElement>('.term').forEach((term) => {
        const pre = term.querySelector('pre');
        const bar = term.querySelector('.bar');
        if (!pre || !bar) return;
        const lines = pre.innerText.split('\n');
        const cmds = lines.filter((l) => l.startsWith('$ ')).map((l) => l.slice(2));
        const text = (cmds.length ? cmds : lines.filter((l) => l.trim() && !l.trim().startsWith('#'))).join('\n');
        const b = button();
        b.setAttribute('aria-label', 'Copy the commands');
        b.addEventListener('click', () => copyText(text, b));
        bar.appendChild(b);
      });
      document.querySelectorAll<HTMLTableElement>('table').forEach((table) => {
        const head = table.querySelector('th');
        if (!head || !/command/i.test(head.textContent || '')) return;
        table.querySelectorAll<HTMLElement>('tbody tr td:first-child code').forEach((code) => {
          const b = button();
          b.classList.add('copy-inline');
          b.setAttribute('aria-label', `Copy ${code.textContent}`);
          b.addEventListener('click', () => copyText(code.textContent || '', b));
          code.after(b);
        });
      });
    </script>
  </body>
</html>
