{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stampede Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "description": "Literal value; stored in the chart's Secret." },
        "existingSecret": { "type": "string", "description": "Name of a Secret you manage." },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" },
        "claims": { "type": "array" }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "array": { "type": "array" },
    "object": { "type": "object" },
    "probe": { "type": ["object", "null"] }
  },
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "$ref": "#/definitions/array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "commonLabels": { "$ref": "#/definitions/stringMap" },
    "masterKey": { "$ref": "#/definitions/secretRef" },
    "joinToken": { "$ref": "#/definitions/secretRef" },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 0, "description": "Server replicas; with ha: standby only one serves at a time." },
        "ha": { "type": "string", "enum": ["standby", "active"], "description": "standby: one replica serves, others wait; active: all serve." },
        "executor": { "type": "string", "enum": ["auto", "workers", "local"] },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "logFormat": { "type": "string", "enum": ["json", "text"] },
        "secureCookies": { "type": "boolean" },
        "trustedProxies": { "type": "array", "items": { "type": "string" } },
        "caps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRate": { "type": "number", "minimum": 0 },
            "maxVUs": { "type": "integer", "minimum": 0 },
            "maxDuration": { "type": "string", "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$" }
          }
        },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "extraEnv": { "$ref": "#/definitions/array" },
        "extraVolumes": { "$ref": "#/definitions/array" },
        "extraVolumeMounts": { "$ref": "#/definitions/array" },
        "dataDir": { "type": "string" },
        "resources": { "$ref": "#/definitions/resources" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "$ref": "#/definitions/array" },
        "affinity": { "$ref": "#/definitions/object" },
        "priorityClassName": { "type": "string" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" },
        "podSecurityContext": { "$ref": "#/definitions/object" },
        "securityContext": { "$ref": "#/definitions/object" },
        "startupProbe": { "$ref": "#/definitions/probe" },
        "livenessProbe": { "$ref": "#/definitions/probe" },
        "readinessProbe": { "$ref": "#/definitions/probe" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "workerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "workerMTLS": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "caFingerprint": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" }
      }
    },
    "workerTLS": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": { "type": "string" },
              "hosts": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0 },
        "region": { "type": "string" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "maxVUs": { "type": "integer", "minimum": 0 },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "extraEnv": { "$ref": "#/definitions/array" },
        "extraVolumes": { "$ref": "#/definitions/array" },
        "extraVolumeMounts": { "$ref": "#/definitions/array" },
        "resources": { "$ref": "#/definitions/resources" },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
            "behavior": { "$ref": "#/definitions/object" }
          }
        },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "$ref": "#/definitions/array" },
        "affinity": { "$ref": "#/definitions/object" },
        "priorityClassName": { "type": "string" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" },
        "podSecurityContext": { "$ref": "#/definitions/object" },
        "securityContext": { "$ref": "#/definitions/object" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "pattern": "^$|^postgres(ql)?://" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "timescaledb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "database": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "username": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "password": { "type": "string", "pattern": "^[A-Za-z0-9._~-]*$", "description": "Must be URL-safe: it is placed in the database URL." },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClass": { "type": "string" },
            "accessModes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "tuneMemory": { "type": "string" },
        "tuneCPUs": { "type": "string" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "$ref": "#/definitions/array" },
        "affinity": { "$ref": "#/definitions/object" },
        "podSecurityContext": { "$ref": "#/definitions/object" },
        "securityContext": { "$ref": "#/definitions/object" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "labels": { "$ref": "#/definitions/stringMap" }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string" }
      }
    }
  }
}
