# Release image of the browser worker, built by GoReleaser (dockers_v2)
# from prebuilt binaries: the stampede binary with Chromium.
FROM debian:bookworm-slim
ARG TARGETPLATFORM
RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium fonts-liberation fonts-noto-color-emoji ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 65532 stampede
COPY $TARGETPLATFORM/stampede /usr/local/bin/stampede
ENV STAMPEDE_CHROME=/usr/bin/chromium STAMPEDE_CHROME_NO_SANDBOX=true
USER stampede
ENTRYPOINT ["/usr/local/bin/stampede"]
CMD ["worker"]
